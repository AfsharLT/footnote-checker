{
  "name": "footnote-checker",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/AfsharLT/footnote-checker.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "generate:mapping": "node scripts/generate-citation-source-mapping.mjs",
    "prebuild": "npm run generate:mapping",
    "build": "webpack --mode production",
    "postbuild": "node scripts/verify-production-build.mjs",
    "prebuild:dev": "npm run generate:mapping",
    "build:dev": "webpack --mode development",
    "predev-server": "npm run generate:mapping",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "prestart": "npm run generate:mapping",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "prewatch": "npm run generate:mapping",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.36.0",
    "es6-promise": "^4.2.8",
    "lucide-react": "^1.33.0",
    "react": "^18.2.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "acorn": "^8.11.3",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint-plugin-office-addins": "^4.0.10",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.4.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "Safari >= 15",
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions"
  ],
  "description": "Word-Add-in zur Pr\u00fcfung juristischer Fu\u00dfnoten"
}

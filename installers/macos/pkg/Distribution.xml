<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Footnote-Checker</title>
  <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64" allow-external-scripts="false"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
  <welcome file="welcome.html" mime-type="text/html"/>
  <readme file="readme.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <choices-outline><line choice="fnc"/></choices-outline>
  <choice id="fnc" title="Footnote-Checker für Word" description="Registriert das Word-Add-in für das eigene Benutzerkonto." visible="false"><pkg-ref id="de.footnote-checker.word-addin.macos"/></choice>
  <pkg-ref id="de.footnote-checker.word-addin.macos" version="0.1.0" onConclusion="None">FNC-component.pkg</pkg-ref>
  <pkg-ref id="de.footnote-checker.word-addin.macos"><must-close><app id="com.microsoft.Word"/></must-close></pkg-ref>
</installer-gui-script>
